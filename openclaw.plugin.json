{
  "id": "cron-travel-mode",
  "name": "Cron Travel Mode",
  "description": "Review OpenClaw cron jobs, move approved explicit-timezone cron schedules to travel-local time, and safely restore them.",
  "version": "0.1.0",
  "activation": {
    "onStartup": false
  },
  "contracts": {
    "tools": [
      "generate_travel_cron_plan",
      "apply_travel_cron_plan",
      "restore_travel_cron_plan",
      "abort_or_recover_travel_cron",
      "travel_cron_status"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "maxInventoryJobs": {
        "type": "number",
        "minimum": 1,
        "maximum": 1000
      },
      "maxInventoryBytes": {
        "type": "number",
        "minimum": 1024,
        "maximum": 1048576
      },
      "defaultLateRestoreThresholdHours": {
        "type": "number",
        "minimum": 0,
        "maximum": 168
      },
      "activationGraceMinutes": {
        "type": "number",
        "minimum": 0,
        "maximum": 240
      }
    }
  }
}
